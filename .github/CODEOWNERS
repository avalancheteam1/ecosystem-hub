# Code owners - GitHub requests their review automatically.
# One block per area; an area's code lives in folders named after it:
#
#   /src/app/(site)/hackathons/        @AvalancheTeam1/hackathons
#   /src/app/admin/hackathons/         @AvalancheTeam1/hackathons
#   /prisma/schema/hackathons.prisma   @AvalancheTeam1/hackathons
#
# Shared core (auth, permissions, db, layout) - changes here affect every area:
#
#   /src/lib/                          @AvalancheTeam1/hub-core
#   /src/components/                   @AvalancheTeam1/hub-core
#   /prisma/schema/base.prisma         @AvalancheTeam1/hub-core

# Referrals & groups
/src/app/(app)/referrals/          @AvalancheTeam1/hub-core
/src/app/(app)/groups/             @AvalancheTeam1/hub-core
/src/app/admin/groups/             @AvalancheTeam1/hub-core
/prisma/schema/referrals.prisma    @AvalancheTeam1/hub-core
/prisma/schema/portal.prisma       @AvalancheTeam1/hub-core

# Events & hackathons (organiser console under /manage, judges under /judge)
/src/app/(site)/events/            @AvalancheTeam1/hub-core
/src/app/admin/events/             @AvalancheTeam1/hub-core
/src/app/(app)/manage/             @AvalancheTeam1/hub-core
/src/app/(app)/judge/              @AvalancheTeam1/hub-core
/prisma/schema/events.prisma       @AvalancheTeam1/hub-core
/prisma/schema/hackathons.prisma   @AvalancheTeam1/hub-core

# Education (Entrepreneur Academy content in _content/)
/src/app/(site)/education/         @AvalancheTeam1/hub-core
/public/education/                 @AvalancheTeam1/hub-core

# Projects
/src/app/(app)/projects/           @AvalancheTeam1/hub-core
/prisma/schema/projects.prisma     @AvalancheTeam1/hub-core

# Profile & dashboard
/src/app/(app)/profile/            @AvalancheTeam1/hub-core
