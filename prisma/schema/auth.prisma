// Better Auth core models. Field names are Better Auth's - don't rename them.

model User {
  id              String   @id
  name            String
  email           String   @unique
  emailVerified   Boolean  @default(false)
  image           String?
  // Builder profile (fields from builders-hub; see src/lib/profile.ts)
  bio             String?
  /// ISO-2
  country         String?
  /// university | founder | developer | employee | enthusiast
  builderRoles    String[]
  institution     String?
  companyName     String?
  employeeRole    String?
  githubAccount   String?
  xAccount        String?
  linkedinAccount String?
  telegramAccount String?
  otherSocials    String[]
  wallets         String[]
  skills          String[]
  newsletterOptIn Boolean  @default(false)
  /// Grantable only by other super admins (/admin/access). SUPER_ADMIN_EMAILS also counts.
  isSuperAdmin    Boolean  @default(false)
  /// Better Auth twoFactor plugin: true once a TOTP app is confirmed.
  twoFactorEnabled Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions           Session[]
  accounts           Account[]
  roles              UserRole[]           @relation("UserRoles")
  permissions        UserPermission[]     @relation("UserPermissions")
  auditLogs          AuditLog[]
  rolesGranted       UserRole[]           @relation("UserRolesGranted")
  permissionsGranted UserPermission[]     @relation("UserPermissionsGranted")
  apiKeysCreated     ApiKey[]
  eventsCreated      Event[]
  projectsOwned      Project[]            @relation("ProjectsOwned")
  projectVersions    ProjectVersion[]
  projectMembers     ProjectMember[]
  projectInvites     ProjectInvite[]      @relation("ProjectInvitesSent")
  organizerOf        HackathonOrganizer[] @relation("OrganizerOf")
  judgeOf            HackathonJudge[]     @relation("JudgeOf")
  participations     Participant[]
  referralCodes      ReferralCode[]
  referralsMade      Referral[]           @relation("ReferralsMade")
  referredBy         Referral?            @relation("ReferredBy")
  groupMemberships   GroupMember[]
  portalProfile      PortalProfile?
  twoFactors         TwoFactor[]
  passkeys           Passkey[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// When this session last proved a second factor (passkey / TOTP / backup code). See src/lib/second-factor.ts.
  secondFactorAt DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

// Better Auth twoFactor plugin (TOTP + backup codes). Secret and codes are encrypted with BETTER_AUTH_SECRET.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

// Better Auth passkey plugin (WebAuthn credentials - public keys only).
model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkeys")
}
