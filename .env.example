# ── Database ──────────────────────────────────────────────────────────────
# Local: `docker compose up -d` (Postgres on port 5432).
DATABASE_URL=postgresql://hub:hub@localhost:5432/hub
# Optional pool tuning (defaults shown)
# DB_POOL_MAX=5
# DB_POOL_IDLE_MS=30000
# DB_POOL_CONNECT_MS=10000

# ── Better Auth ───────────────────────────────────────────────────────────
# `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public origin of the app (http://localhost:3000 locally, https://hub.team1.network in prod)
BETTER_AUTH_URL=http://localhost:3000

# Social sign-in - each provider is enabled only when both values are set.
# Google callback:  <BETTER_AUTH_URL>/api/auth/callback/google
# GitHub callback:  <BETTER_AUTH_URL>/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Mail (email OTP sign-in) ──────────────────────────────────────────────
# Unset SMTP_HOST in development = codes are printed to the dev-server console.
# In production a missing SMTP_HOST makes OTP sign-in fail loudly.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Team1 Ecosystem Hub <hub@team1.network>"

# Cloudflare Turnstile on the "send code" step (Cloudflare dashboard → Turnstile).
# Both unset = no captcha (fine for dev). Always-pass test keys:
#   site 1x00000000000000000000AA  secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Access ────────────────────────────────────────────────────────────────
# Comma-separated emails that are always super admins (bootstrap / break-glass).
SUPER_ADMIN_EMAILS=

# ── Public (inlined at build time - also set as Railway build args) ──────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Plausible (self-hosted). Empty = no analytics script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Image uploads (Cloudflare R2, S3-compatible) ─────────────────────────
# Without a bucket, development falls back to public/uploads/ (local provider).
# Production requires STORAGE_PROVIDER=s3 and all of the below.
# STORAGE_PROVIDER=s3
STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_BUCKET=team1-hub
# Public CDN base for the bucket, no trailing slash. Also drives the next/image host - set at build time too.
STORAGE_PUBLIC_BASE_URL=https://hub.cdn.team1.network

# ── Member portal (public API, no key) ────────────────────────────────────
MEMBER_PORTAL_URL=https://members.team1.network
MEMBER_PORTAL_API_KEY=

# ── System alerts ─────────────────────────────────────────────────────────
# Webhook for operator alerts (anything accepting
# POST { title, message, priority }): failed/partial jobs, worker crash.
# Unset = alerts skipped. Set it on the worker service. See src/lib/system-alert.ts.
SYSTEM_NOTIFICATION_URL=

# External monitor push URL (e.g. healthchecks.io ping URL). The worker GETs it
# after every job run (success or failure) - a silence of 24h means the worker
# is dead (events-portal-import runs hourly). Unset = skipped. Worker service only.
# HEARTBEAT_URL=

# ── Logging ───────────────────────────────────────────────────────────────
# Key for the HMAC of emails/IPs in security logs (>= 16 chars). Falls back to a key
# derived from BETTER_AUTH_SECRET, then (outside production) a dev constant. Warned about in production when unset.
LOG_HASH_SECRET=

# ── GlitchTip (Sentry SDK, errors only) ───────────────────────────────────
# All optional; unset or blank = off (no SDK init, no upload, no network calls).
# Server + worker DSN (runtime). Set it on both Railway services.
SENTRY_DSN=
# Browser DSN, inlined at build (Docker build arg). Usually the same DSN. Events go
# through the same-origin tunnel /monitoring, which only forwards to this DSN.
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload during the web build (Docker build args). Without the token
# nothing is uploaded. Set the token on the web service only, never the worker,
# and give it only the scopes source-map upload needs (no admin/member scopes).
SENTRY_URL=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
